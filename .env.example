# Local development — credentials loaded from here.
# Production on Azure uses Key Vault instead (see backend/app/secrets.py).

# --- Database ---
DATABASE_URL=

# --- Azure storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_IMAGES_CONTAINER_NAME=claims-images
AZURE_STORAGE_VIDEOS_CONTAINER_NAME=claims-videos
AZURE_STORAGE_PDS_POLICIES_CONTAINER_NAME=pds-policies

# --- AI providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- ChromaDB (vector store) ---
# Leave CHROMA_HOST empty to use local persistent storage in CHROMA_PERSIST_DIRECTORY.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=claim-ai

# --- Auth ---
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# --- Notifications ---
AZURE_COMMUNICATION_CONNECTION_STRING=
