# Local development — credentials loaded from here.
# Production on Azure uses Key Vault instead (see backend/app/connectors/secrets.py).

# --- Database ---
DATABASE_URL=

# --- Azure storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_IMAGES_CONTAINER_NAME=claims-images
AZURE_STORAGE_VIDEOS_CONTAINER_NAME=claims-videos
AZURE_STORAGE_PDS_POLICIES_CONTAINER_NAME=pds-policies

# --- Azure AI Foundry (GPT 5.5 + Claude Opus via model-router) ---
# Both models are served from Azure AI Foundry — no OpenAI or Anthropic API keys needed.
# Project endpoint from the Foundry portal (Project overview > Endpoint).
AZURE_AI_PROJECT_ENDPOINT=
# Optional. If empty, derived from the project endpoint host.
AZURE_AI_SERVICES_ENDPOINT=
# Deployment names in your Foundry project.
FOUNDRY_GPT_DEPLOYMENT=gpt-5.5
# Cheaper tiers - Call 2 (consistency check) and the CRAG evaluator use mini;
# the claim plausibility gate at intake uses nano.
FOUNDRY_MINI_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_NANO_DEPLOYMENT=gpt-5.4-nano
FOUNDRY_ROUTER_DEPLOYMENT=model-router
# Claude Opus slot — use model-router in australiaeast (Claude not deployable directly there).
FOUNDRY_CLAUDE_DEPLOYMENT=model-router

# --- Other AI services ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- ChromaDB (vector store) ---
# Leave CHROMA_HOST empty to use local persistent storage in CHROMA_PERSIST_DIRECTORY.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=claim-ai

# --- Auth ---
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# Comma-separated browser origins allowed to call /api (Vue/Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Notifications ---
AZURE_COMMUNICATION_CONNECTION_STRING=
# Verified sender identities in the ACS resource.
AZURE_COMMUNICATION_EMAIL_SENDER=
AZURE_COMMUNICATION_SMS_SENDER=
# Set to false to skip all customer notifications without touching the ACS credentials.
NOTIFICATIONS_ENABLED=false
