# PII Reduction Service — local overrides (never commit real secrets)
CLAIM_AI_ENCRYPTION_KEY=
# EgoBlur Gen1 JIT models (download: python scripts/download_egoblur_models.py)
REDACTION_BACKEND=egoblur
EGOBLUR_FACE_MODEL_PATH=models/ego_blur_face.jit
EGOBLUR_LP_MODEL_PATH=models/ego_blur_lp.jit
EGOBLUR_FACE_SCORE_THRESHOLD=0.45
EGOBLUR_LP_SCORE_THRESHOLD=0.55
METADATA_BACKEND=exiftool
OCR_BACKEND=tesseract
# Windows: set full path if `tesseract` is not on PATH after install
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
API_KEYS_PII_PROCESSOR=dev-processor-key
API_KEYS_PII_REHYDRATOR=dev-rehydrator-key
API_KEYS_CLAIMS_USER=dev-claims-key
API_KEYS_AUDITOR=dev-auditor-key
API_KEYS_ADMIN=dev-admin-key
