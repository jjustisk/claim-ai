# =============================================================================
# Claim AI — Docker runtime config (NOT a dump of Key Vault secrets)
#
# Secrets (DATABASE_URL, JWT_SECRET_KEY, storage, Foundry, ACS, …) are loaded
# from Azure Key Vault: https://claim-ai-kv.vault.azure.net/
#
# This file only needs:
#   - non-secret toggles / ports / CORS
#   - Azure identity so the container can READ the vault
#   - CLAIM_AI_ENCRYPTION_KEY if that secret is not in the vault yet
#   - CHROMA_AUTH_TOKEN (required — Chroma server token auth)
#
#   cp .env.docker.example .env.docker
#   # generate token: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   docker compose --env-file .env.docker up --build
#
# NEVER commit .env.docker. NEVER bake secrets into images.
# =============================================================================

APP_ENV=production
CLAIM_AI_SECRETS_SOURCE=vault
ENABLE_TEST_UI=false
ENABLE_OPENAPI_DOCS=false

# Published ports on the host
# If 8080 is already in use on Windows, set FRONTEND_PORT=8088
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Docker Hub image namespace (private repos under this account)
DOCKERHUB_NAMESPACE=ctinashe
IMAGE_TAG=local

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Key Vault ---
AZURE_KEY_VAULT_NAME=claim-ai-kv
# Optional full URL override:
# AZURE_KEY_VAULT_URL=https://claim-ai-kv.vault.azure.net/

# How the container authenticates TO the vault / Foundry:
# On Azure Container Apps / AKS: leave the three below blank (Managed Identity).
# On a local Docker Desktop machine: use a service principal with Key Vault get access.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# PII Fernet key — only if not stored in Key Vault yet.
# Prefer adding it to the vault; until then set it here at runtime (not in the image).
CLAIM_AI_ENCRYPTION_KEY=

# --- ChromaDB (compose service "chroma", internal network only) ---
# Leave host as "chroma" when using docker compose. Empty host = embedded local disk
# (not used by the compose backend — compose forces CHROMA_HOST=chroma).
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=claim-ai
# REQUIRED: shared Bearer token for Chroma server auth.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CHROMA_AUTH_TOKEN=

# --- Escape hatch only (normally leave blank; vault supplies these) ---
# Set CLAIM_AI_SECRETS_SOURCE=env if you intentionally bypass Key Vault.
# DATABASE_URL=
# JWT_SECRET_KEY=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_AI_PROJECT_ENDPOINT=

# --- Optional local Postgres profile (`--profile local-db`) ---
# REQUIRED when using --profile local-db (no default password).
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
